{
  // ─── Local development: SQLite (no Docker required) ──────────────────────────
  // To use PostgreSQL locally: remove or comment the Database section below.
  // To use SQL Server locally: change Provider to "SqlServer" and ConnectionStringName accordingly.
  "Database": {
    "Provider": "SqlServer",
    "ConnectionStringName": "SqlServerConnection",
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft":                                        "Information",
        "Microsoft.EntityFrameworkCore.Database.Command":  "Information",
        "System":                                          "Information"
      }
    }
  }
}
