<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EnterpriseApp.Infrastructure</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU1603: HybridCache 9.0.0 no existe en NuGet; la version minima disponible es 9.3.0.
         NU1605: DI.Abstractions se ancla a 9.0.3 para evitar el downgrade transitivo de Redis. -->
    <NoWarn>NU1603;NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core shared framework — required by Infrastructure.Authorization
         (IAuthorizationHandler, AuthorizationPolicyBuilder, IAuthorizationPolicyProvider).
         Acceptable trade-off: this project wires authorization handlers, so it
         already lives in the ASP.NET Core ecosystem. Application stays clean. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- JWT signing for Role.PermissionsSnapshot (replaces NHCS ConcurrencyStamp pattern) -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 9 — núcleo + los tres proveedores soportados -->
    <PackageReference Include="Microsoft.EntityFrameworkCore"                Version="9.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"        Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer"      Version="9.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"         Version="9.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"         Version="9.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Caching: Hybrid se ancla a 9.3.0 porque 9.0.0 no existe en el feed publico.
         StackExchangeRedis DEBE quedarse en >= 9.0.19. En 9.0.5 y anteriores el ctor de
         RedisCacheImpl llama a IsHybridCacheDefined(sp) -> sp.GetService<HybridCache>(),
         y DefaultHybridCache resuelve IDistributedCache -> RedisCacheImpl: ciclo de DI
         infinito que el contenedor NO detecta (el GetService ocurre dentro del ctor, no
         es una dependencia declarada). Cada nivel de recursion bloquea un hilo via
         StackGuard.RunOnEmptyStack -> thread pool starvation -> TODA request se cuelga.
         Verificado A/B en repro aislado: 9.0.5 cuelga, 9.0.19 resuelve OK. -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.19" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid"             Version="9.3.0" />
    <!-- Observability -->
    <PackageReference Include="Serilog.AspNetCore"   Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq"    Version="9.0.0" />
    <!-- Resilience -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.3.0" />
    <!-- DI — debe ir alineado con la version de Caching.StackExchangeRedis (9.0.19),
         que arrastra Microsoft.Extensions.Options/DI.Abstractions 9.0.19. Dejarlo en
         9.0.3 provoca NU1605 (package downgrade) en EnterpriseApp.API. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.19" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnterpriseApp.Application\EnterpriseApp.Application.csproj" />
  </ItemGroup>
</Project>
